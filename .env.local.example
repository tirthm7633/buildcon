# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, never exposed to the browser. Used for
# inviting staff accounts from Settings > Team.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
